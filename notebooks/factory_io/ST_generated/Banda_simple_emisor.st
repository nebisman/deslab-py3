(* OpenPLC random number (C code), used to pick one of several orders *)
FUNCTION_BLOCK random_number
	VAR_INPUT
		IN : BOOL;
	END_VAR
	VAR
		M : BOOL;
		INIT : BOOL;
	END_VAR
	VAR_OUTPUT
		OUT : DINT;
	END_VAR

	IF INIT = 0 THEN
		{#include <stdio.h>}
		{#include <stdlib.h>}
		IN := 1;
	END_IF;
	IF M = 0 and IN = 1 THEN
		{SetFbVar(OUT,rand())}
	END_IF;
END_FUNCTION_BLOCK
(* Controller generated by DESlab (generate_ST_OPENPLC). Every scan it: *)
(* 1. computes the input edges and a random number *)
(* 2. during the first second after the PLC starts, does nothing else *)
(* 3. each automaton moves with at most one uncontrollable event *)
(* 4. each automaton writes the orders enabled in its state; if there are several, it picks one at random *)
(* 5. each automaton moves with the order that was given (controllable event) *)
(* 6. copies signals to other outputs (Mask) *)
(* The states of each automaton are numbered from 0, its initial state: *)
(* state[0]: supervisor SUP -- emisor *)
PROGRAM supcon
	VAR
		(* Internal variables *)
		random : random_number; (* random number generator *)
		random_num : DINT; (* random number of this scan *)
		startup_delay : TON; (* startup delay: no event or order during the first second of the PLC *)
		state : ARRAY [0..1] OF DINT; (* state of each automaton; the list is at the start of the program *)
		RE_INICIO : R_TRIG; (* rising edge of SensorInicio: Caja-inicio *)
		RE_SALE : R_TRIG; (* rising edge of SensorFin: Caja-sale *)
	END_VAR
	VAR
		(* PLC inputs and outputs *)
		Banda AT %QX100.0 : BOOL; (* output; copy of TRUE (Mask) *)
 		Remover AT %QX100.2 : BOOL; (* output; copy of TRUE (Mask) *)
 		Emisor AT %QX100.1 : BOOL; (* output; 1 for Emisor-ON; 0 for Emisor-OFF *)
		SensorInicio AT %IX100.0 : BOOL; (* input; rising edge (RE_INICIO): Caja-inicio *)
		SensorFin AT %IX100.1 : BOOL; (* input; rising edge (RE_SALE): Caja-sale *)
	END_VAR
	(* Input edges *)
	RE_INICIO(CLK:= SensorInicio); (* Caja-inicio *)
	RE_SALE(CLK:= SensorFin); (* Caja-sale *)
	(* Random number of this scan *)
	random(
		IN := True,
		OUT => random_num);
	(* Startup delay: during the first second the edges only follow the inputs, which read 0 until the first poll of the slave devices; no event, order or copy *)
	startup_delay(IN := TRUE, PT := T#1s);
	IF NOT startup_delay.Q THEN
		RETURN;
	END_IF;
	(* ===== Uncontrollable events: each automaton moves with at most one per scan ===== *)
	(* supervisor SUP -- emisor (state[0]): uncontrollable transitions *)
	IF state[0] = 0 & RE_INICIO.Q THEN (* Caja-inicio *)
  		state[0] := 1;
  	ELSIF state[0] = 1 & RE_SALE.Q THEN (* Caja-sale *)
  		state[0] := 0;
  	ELSIF state[0] = 2 & RE_INICIO.Q THEN (* Caja-inicio *)
  		state[0] := 4;
  	ELSIF state[0] = 3 & RE_SALE.Q THEN (* Caja-sale *)
  		state[0] := 5;
  	ELSIF state[0] = 4 & RE_SALE.Q THEN (* Caja-sale *)
  		state[0] := 6;
  	ELSIF state[0] = 5 & RE_INICIO.Q THEN (* Caja-inicio *)
  		state[0] := 8;
  	ELSIF state[0] = 6 & RE_INICIO.Q THEN (* Caja-inicio *)
  		state[0] := 8;
  	ELSIF state[0] = 7 & RE_SALE.Q THEN (* Caja-sale *)
  		state[0] := 0;
  	ELSIF state[0] = 8 & RE_SALE.Q THEN (* Caja-sale *)
  		state[0] := 6;
  	END_IF;

	(* ===== Orders: each automaton writes the orders enabled in its state; if there are several, it picks one at random ===== *)

	(* supervisor SUP -- emisor (state[0]): orders of each state *)
	CASE state[0] OF
  		0:
  			Emisor := 1; (* Emisor-ON *)
		1:
  			Emisor := 1; (* Emisor-ON *)
		4:
  			Emisor := 0; (* Emisor-OFF *)
  		6:
  			Emisor := 0; (* Emisor-OFF *)
  		8:
  			Emisor := 0; (* Emisor-OFF *)
  	END_CASE;
	(* ===== Orders given: each automaton moves with the controllable event of the order ===== *)
	(* supervisor SUP -- emisor (state[0]): controllable transitions *)
	IF state[0] = 0 & Emisor THEN (* Emisor-ON *)
  		state[0] := 2;
  	ELSIF state[0] = 1 & Emisor THEN (* Emisor-ON *)
  		state[0] := 3;
  	ELSIF state[0] = 4 & NOT Emisor THEN (* Emisor-OFF *)
  		state[0] := 7;
  	ELSIF state[0] = 6 & NOT Emisor THEN (* Emisor-OFF *)
  		state[0] := 0;
  	ELSIF state[0] = 8 & NOT Emisor THEN (* Emisor-OFF *)
  		state[0] := 1;
  	END_IF;

	(* ===== Copies of signals to other outputs (Mask) ===== *)
	Banda := TRUE;
 	Remover := TRUE;
 
END_PROGRAM

CONFIGURATION Config0

	RESOURCE Res0 ON PLC
		TASK task0(INTERVAL := T#20ms,PRIORITY := 0);
		PROGRAM instance0 WITH task0 : supcon;
	END_RESOURCE
END_CONFIGURATION