(* OpenPLC random number (C code), used to pick one of several orders *)
FUNCTION_BLOCK random_number
	VAR_INPUT
		IN : BOOL;
	END_VAR
	VAR
		M : BOOL;
		INIT : BOOL;
	END_VAR
	VAR_OUTPUT
		OUT : DINT;
	END_VAR

	IF INIT = 0 THEN
		{#include <stdio.h>}
		{#include <stdlib.h>}
		IN := 1;
	END_IF;
	IF M = 0 and IN = 1 THEN
		{SetFbVar(OUT,rand())}
	END_IF;
END_FUNCTION_BLOCK
(* Controller generated by DESlab (generate_ST_OPENPLC). Every scan it: *)
(* 1. computes the input edges and a random number *)
(* 2. waits for the start signal (start); from then on it runs the next steps every scan *)
(* 3. each automaton moves with at most one uncontrollable event *)
(* 4. each automaton writes the orders enabled in its state; if there are several, it picks one at random *)
(* 5. an order shared by several supervisors changes only if all of them propose it *)
(* 6. each automaton moves with the order that was given (controllable event) *)
(* 7. pairs turn internal requests into orders *)
(* 8. copies signals to other outputs (Mask) *)
(* The states of each automaton are numbered from 0, its initial state: *)
(* state[0]: supervisor S_1 *)
(* state[1]: supervisor S_2 *)
(* state[2]: auxiliary automaton M1 *)
(* state[3]: auxiliary automaton M2 *)
(* state[4]: auxiliary automaton generate *)
(* state[5]: auxiliary automaton Buffer_fill *)
(* state[6]: auxiliary automaton Blade *)
(* state[7]: auxiliary automaton repair *)
PROGRAM supcon
	VAR
		(* Internal variables *)
		random : random_number; (* random number generator *)
		random_num : DINT; (* random number of this scan *)
		initial : BOOL; (* 1 once the start signal (start) has arrived *)
		state : ARRAY [0..8] OF DINT; (* state of each automaton; the list is at the start of the program *)
		slt0 : ARRAY [0..2] OF DINT; (* random choices of supervisor S_1, one per state with several orders *)
		slt1 : ARRAY [0..12] OF DINT; (* random choices of supervisor S_2, one per state with several orders *)
		INTERN_0_G : ARRAY [0..2] OF BOOL; (* proposals of INTERN_0 from [0] supervisor S_1, [1] supervisor S_2 *)
		INTERN_1_G : ARRAY [0..2] OF BOOL; (* proposals of INTERN_1 from [0] supervisor S_1, [1] supervisor S_2 *)
		FE_M1E : F_TRIG; (* falling edge of GD_IN_0: M1-END *)
		FE_M2E : F_TRIG; (* falling edge of GD_IN_1: t2 *)
		FE_A : F_TRIG; (* falling edge of GD_IN_2: Fed *)
		FE_PL : F_TRIG; (* falling edge of GD_IN_3: t1 *)
		FE_PR : F_TRIG; (* falling edge of GD_IN_4: Piece-ready *)
		INTERN_4 : BOOL; (* internal variable; 0 for M1-REPAIR-DONE *)
		INTERN_5 : BOOL; (* internal variable; 0 for M2-REPAIR-DONE *)
		INTERN_2 : BOOL; (* internal variable; 1 for R1-PERMITTED; 0 for R1-NOT-PERMITTED *)
		INTERN_3 : BOOL; (* internal variable; 1 for R2-PERMITTED; 0 for R2-NOT-PERMITTED *)
		INTERN_0 : BOOL; (* internal variable; 1 for e1 *)
		INTERN_1 : BOOL; (* internal variable; 1 for e2 *)
	END_VAR
	VAR
		(* PLC inputs and outputs *)
		GD_OUT_3 AT %QX100.3 : BOOL; (* output; copy of GD_OUT_2 (Mask) *)
 		GD_OUT_8 AT %QX101.0 : BOOL; (* output; copy of NOT GD_IN_10 (Mask) *)
 		GD_OUT_9 AT %QX101.1 : BOOL; (* output; copy of NOT GD_IN_11 (Mask) *)
 		GD_OUT_0 AT %QX100.0 : BOOL; (* output; 1 for M1-ON; 0 for M1-OFF *)
		GD_OUT_1 AT %QX100.1 : BOOL; (* output; 1 for M2-ON; 0 for M2-OFF *)
		GD_IN_0 AT %IX100.0 : BOOL; (* input; 1 for M1-Busy; 0 for M1-NOT-Busy; falling edge (FE_M1E): M1-END *)
		GD_IN_1 AT %IX100.1 : BOOL; (* input; 1 for M2-Busy; falling edge (FE_M2E): t2 *)
		GD_IN_15 AT %IX100.5 : BOOL; (* input; 1 for start *)
		GD_OUT_2 AT %QX100.2 : BOOL; (* output; 1 for BA-ON; 0 for BA-OFF *)
		GD_IN_2 AT %IX100.2 : BOOL; (* input; falling edge (FE_A): Fed *)
		GD_OUT_4 AT %QX100.4 : BOOL; (* output; 1 for Buffer-conveyor-ON, Buffer-conveyor-ON-UC; 0 for Buffer-conveyor-OFF *)
		GD_IN_3 AT %IX100.3 : BOOL; (* input; falling edge (FE_PL): t1 *)
		GD_IN_4 AT %IX100.4 : BOOL; (* input; falling edge (FE_PR): Piece-ready *)
		GD_OUT_5 AT %QX100.5 : BOOL; (* output; 1 for Piece-restart-ON; 0 for Piece-restart-OFF *)
		GD_OUT_6 AT %QX100.6 : BOOL; (* output; 1 for Blade-ON; 0 for Blade-OFF *)
		GD_IN_10 AT %IX101.0 : BOOL; (* input; 0 for f1 *)
		GD_IN_11 AT %IX101.1 : BOOL; (* input; 0 for f2 *)
		GD_IN_12 AT %IX101.2 : BOOL; (* input; 1 for M1-REPAIR *)
		GD_IN_13 AT %IX101.3 : BOOL; (* input; 1 for M2-REPAIR *)
		GD_OUT_10 AT %QX101.2 : BOOL; (* output; 1 for r1; 0 for M1-REPAIR-OUT-OFF *)
		GD_OUT_11 AT %QX101.3 : BOOL; (* output; 1 for r2; 0 for M2-REPAIR-OUT-OFF *)
	END_VAR
	(* Input edges *)
	FE_M1E(CLK:= GD_IN_0); (* M1-END *)
	FE_M2E(CLK:= GD_IN_1); (* t2 *)
	FE_A(CLK:= GD_IN_2); (* Fed *)
	FE_PL(CLK:= GD_IN_3); (* t1 *)
	FE_PR(CLK:= GD_IN_4); (* Piece-ready *)
	(* Random number of this scan *)
	random(
		IN := True,
		OUT => random_num);
	(* Waits for the start signal (start); from then on it runs the controller every scan *)
	IF NOT initial THEN
		IF GD_IN_15 THEN
			initial := 1;
		END_IF;
	ELSIF initial THEN (* controller *)
		(* ===== Uncontrollable events: each automaton moves with at most one per scan ===== *)
		(* supervisor S_1 (state[0]): uncontrollable transitions *)
		IF state[0] = 1 & NOT GD_IN_10 THEN (* f1 *)
	  		state[0] := 2;
	  	ELSIF state[0] = 1 & FE_PL.Q THEN (* t1 *)
	  		state[0] := 3;
	  	ELSIF state[0] = 2 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[0] := 0;
	  	ELSIF state[0] = 4 & NOT GD_IN_10 THEN (* f1 *)
	  		state[0] := 7;
	  	ELSIF state[0] = 4 & FE_PL.Q THEN (* t1 *)
	  		state[0] := 8;
	  	ELSIF state[0] = 5 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 9;
	  	ELSIF state[0] = 5 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 0;
	  	ELSIF state[0] = 6 & NOT GD_IN_10 THEN (* f1 *)
	  		state[0] := 10;
	  	ELSIF state[0] = 6 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 11;
	  	ELSIF state[0] = 6 & FE_PL.Q THEN (* t1 *)
	  		state[0] := 12;
	  	ELSIF state[0] = 6 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 1;
	  	ELSIF state[0] = 7 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[0] := 3;
	  	ELSIF state[0] = 9 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 13;
	  	ELSIF state[0] = 10 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[0] := 5;
	  	ELSIF state[0] = 10 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 14;
	  	ELSIF state[0] = 10 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 2;
	  	ELSIF state[0] = 11 & NOT GD_IN_10 THEN (* f1 *)
	  		state[0] := 14;
	  	ELSIF state[0] = 11 & FE_PL.Q THEN (* t1 *)
	  		state[0] := 15;
	  	ELSIF state[0] = 11 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 16;
	  	ELSIF state[0] = 12 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 15;
	  	ELSIF state[0] = 12 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 3;
	  	ELSIF state[0] = 14 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[0] := 9;
	  	ELSIF state[0] = 14 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 18;
	  	ELSIF state[0] = 15 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 20;
	  	ELSIF state[0] = 16 & NOT GD_IN_10 THEN (* f1 *)
	  		state[0] := 18;
	  	ELSIF state[0] = 16 & FE_PL.Q THEN (* t1 *)
	  		state[0] := 20;
	  	ELSIF state[0] = 17 & NOT GD_IN_10 THEN (* f1 *)
	  		state[0] := 21;
	  	ELSIF state[0] = 17 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 19;
	  	ELSIF state[0] = 17 & FE_PL.Q THEN (* t1 *)
	  		state[0] := 22;
	  	ELSIF state[0] = 17 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 4;
	  	ELSIF state[0] = 18 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[0] := 13;
	  	ELSIF state[0] = 19 & NOT GD_IN_10 THEN (* f1 *)
	  		state[0] := 23;
	  	ELSIF state[0] = 19 & FE_PL.Q THEN (* t1 *)
	  		state[0] := 24;
	  	ELSIF state[0] = 19 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 25;
	  	ELSIF state[0] = 21 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[0] := 12;
	  	ELSIF state[0] = 21 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 23;
	  	ELSIF state[0] = 21 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 7;
	  	ELSIF state[0] = 22 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 24;
	  	ELSIF state[0] = 22 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 8;
	  	ELSIF state[0] = 23 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[0] := 15;
	  	ELSIF state[0] = 23 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 27;
	  	ELSIF state[0] = 24 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 28;
	  	ELSIF state[0] = 25 & NOT GD_IN_10 THEN (* f1 *)
	  		state[0] := 27;
	  	ELSIF state[0] = 25 & FE_PL.Q THEN (* t1 *)
	  		state[0] := 28;
	  	ELSIF state[0] = 26 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 9;
	  	ELSIF state[0] = 26 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 13;
	  	ELSIF state[0] = 27 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[0] := 20;
	  	ELSIF state[0] = 29 & NOT GD_IN_10 THEN (* f1 *)
	  		state[0] := 30;
	  	ELSIF state[0] = 29 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 11;
	  	ELSIF state[0] = 29 & FE_PL.Q THEN (* t1 *)
	  		state[0] := 31;
	  	ELSIF state[0] = 29 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 16;
	  	ELSIF state[0] = 30 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[0] := 26;
	  	ELSIF state[0] = 30 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 14;
	  	ELSIF state[0] = 30 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 18;
	  	ELSIF state[0] = 31 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 15;
	  	ELSIF state[0] = 31 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 20;
	  	ELSIF state[0] = 32 & NOT GD_IN_10 THEN (* f1 *)
	  		state[0] := 33;
	  	ELSIF state[0] = 32 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 19;
	  	ELSIF state[0] = 32 & FE_PL.Q THEN (* t1 *)
	  		state[0] := 34;
	  	ELSIF state[0] = 32 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 25;
	  	ELSIF state[0] = 33 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[0] := 31;
	  	ELSIF state[0] = 33 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 23;
	  	ELSIF state[0] = 33 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 27;
	  	ELSIF state[0] = 34 & NOT GD_IN_11 THEN (* f2 *)
	  		state[0] := 24;
	  	ELSIF state[0] = 34 & FE_M2E.Q THEN (* t2 *)
	  		state[0] := 28;
	  	END_IF;
	
		(* supervisor S_2 (state[1]): uncontrollable transitions *)
		IF state[1] = 0 & GD_IN_15 THEN (* start *)
	  		state[1] := 1;
	  	ELSIF state[1] = 2 & FE_A.Q THEN (* Fed *)
	  		state[1] := 5;
	  	ELSIF state[1] = 3 & NOT GD_IN_10 THEN (* f1 *)
	  		state[1] := 9;
	  	ELSIF state[1] = 3 & FE_PL.Q THEN (* t1 *)
	  		state[1] := 1;
	  	ELSIF state[1] = 4 & NOT GD_IN_11 THEN (* f2 *)
	  		state[1] := 10;
	  	ELSIF state[1] = 4 & FE_M2E.Q THEN (* t2 *)
	  		state[1] := 1;
	  	ELSIF state[1] = 6 & FE_A.Q THEN (* Fed *)
	  		state[1] := 12;
	  	ELSIF state[1] = 6 & NOT GD_IN_10 THEN (* f1 *)
	  		state[1] := 15;
	  	ELSIF state[1] = 6 & FE_PL.Q THEN (* t1 *)
	  		state[1] := 2;
	  	ELSIF state[1] = 7 & FE_A.Q THEN (* Fed *)
	  		state[1] := 13;
	  	ELSIF state[1] = 7 & NOT GD_IN_11 THEN (* f2 *)
	  		state[1] := 16;
	  	ELSIF state[1] = 7 & FE_M2E.Q THEN (* t2 *)
	  		state[1] := 2;
	  	ELSIF state[1] = 8 & NOT GD_IN_10 THEN (* f1 *)
	  		state[1] := 17;
	  	ELSIF state[1] = 8 & NOT GD_IN_11 THEN (* f2 *)
	  		state[1] := 18;
	  	ELSIF state[1] = 8 & FE_PL.Q THEN (* t1 *)
	  		state[1] := 4;
	  	ELSIF state[1] = 8 & FE_M2E.Q THEN (* t2 *)
	  		state[1] := 3;
	  	ELSIF state[1] = 9 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[1] := 1;
	  	ELSIF state[1] = 10 & FE_M2E.Q THEN (* t2 *)
	  		state[1] := 1;
	  	ELSIF state[1] = 11 & FE_M1E.Q THEN (* M1-END *)
	  		state[1] := 1;
	  	ELSIF state[1] = 12 & NOT GD_IN_10 THEN (* f1 *)
	  		state[1] := 22;
	  	ELSIF state[1] = 12 & FE_PL.Q THEN (* t1 *)
	  		state[1] := 5;
	  	ELSIF state[1] = 13 & NOT GD_IN_11 THEN (* f2 *)
	  		state[1] := 23;
	  	ELSIF state[1] = 13 & FE_M2E.Q THEN (* t2 *)
	  		state[1] := 5;
	  	ELSIF state[1] = 14 & FE_A.Q THEN (* Fed *)
	  		state[1] := 21;
	  	ELSIF state[1] = 14 & NOT GD_IN_10 THEN (* f1 *)
	  		state[1] := 24;
	  	ELSIF state[1] = 14 & NOT GD_IN_11 THEN (* f2 *)
