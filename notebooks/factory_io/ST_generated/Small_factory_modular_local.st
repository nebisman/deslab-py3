	  	ELSIF state[1] = 15 & FE_A.Q THEN (* Fed *)
	  		state[1] := 22;
	  	ELSIF state[1] = 15 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[1] := 2;
	  	ELSIF state[1] = 16 & FE_A.Q THEN (* Fed *)
	  		state[1] := 23;
	  	ELSIF state[1] = 16 & FE_M2E.Q THEN (* t2 *)
	  		state[1] := 2;
	  	ELSIF state[1] = 17 & NOT GD_IN_0 THEN (* M1-NOT-Busy *)
	  		state[1] := 4;
	  	ELSIF state[1] = 17 & NOT GD_IN_11 THEN (* f2 *)
	  		state[1] := 26;
	  	ELSIF state[1] = 17 & FE_M2E.Q THEN (* t2 *)
	  		state[1] := 9;
	  	ELSIF state[1] = 18 & NOT GD_IN_10 THEN (* f1 *)
	  		state[1] := 26;
	  	ELSIF state[1] = 18 & FE_PL.Q THEN (* t1 *)
