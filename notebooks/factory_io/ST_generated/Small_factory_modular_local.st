	  		state[1] := 36;
	  	END_IF;
	
		(* auxiliary automaton M1 (state[2]): controllable transitions *)
		IF state[2] = 2 & NOT GD_OUT_0 THEN (* M1-OFF *)
	  		state[2] := 3;
	  	END_IF;
	
		(* auxiliary automaton M2 (state[3]): controllable transitions *)
		IF state[3] = 2 & NOT GD_OUT_1 THEN (* M2-OFF *)
	  		state[3] := 3;
	  	END_IF;
	
		(* auxiliary automaton generate (state[4]): controllable transitions *)
		IF state[4] = 2 & GD_OUT_5 THEN (* Piece-restart-ON *)
	  		state[4] := 4;
	  	ELSIF state[4] = 5 & NOT GD_OUT_5 THEN (* Piece-restart-OFF *)
	  		state[4] := 0;
	  	END_IF;
	
		(* auxiliary automaton Buffer_fill (state[5]): controllable transitions *)
		IF state[5] = 2 & GD_OUT_4 THEN (* Buffer-conveyor-ON *)
	  		state[5] := 4;
	  	ELSIF state[5] = 5 & NOT GD_OUT_4 THEN (* Buffer-conveyor-OFF *)
	  		state[5] := 6;
	  	ELSIF state[5] = 7 & GD_OUT_4 THEN (* Buffer-conveyor-ON *)
	  		state[5] := 8;
	  	ELSIF state[5] = 9 & NOT GD_OUT_4 THEN (* Buffer-conveyor-OFF *)
	  		state[5] := 6;
	  	END_IF;
	
		(* auxiliary automaton Blade (state[6]): controllable transitions *)
		IF state[6] = 1 & NOT GD_OUT_6 THEN (* Blade-OFF *)
	  		state[6] := 2;
	  	ELSIF state[6] = 3 & GD_OUT_6 THEN (* Blade-ON *)
	  		state[6] := 0;
	  	END_IF;
	
		(* auxiliary automaton repair (state[7]): controllable transitions *)
		IF state[7] = 1 & INTERN_2 THEN (* R1-PERMITTED *)
	  		state[7] := 3;
	  	ELSIF state[7] = 2 & INTERN_3 THEN (* R2-PERMITTED *)
	  		state[7] := 4;
	  	ELSIF state[7] = 5 & GD_OUT_10 THEN (* r1 *)
	  		state[7] := 9;
	  	ELSIF state[7] = 6 & NOT INTERN_2 THEN (* R1-NOT-PERMITTED *)
	  		state[7] := 10;
	  	ELSIF state[7] = 7 & GD_OUT_11 THEN (* r2 *)
	  		state[7] := 11;
	  	ELSIF state[7] = 9 & NOT INTERN_2 THEN (* R1-NOT-PERMITTED *)
	  		state[7] := 13;
	  	ELSIF state[7] = 10 & INTERN_3 THEN (* R2-PERMITTED *)
	  		state[7] := 8;
	  	ELSIF state[7] = 11 & NOT INTERN_3 THEN (* R2-NOT-PERMITTED *)
	  		state[7] := 14;
	  	ELSIF state[7] = 12 & GD_OUT_11 THEN (* r2 *)
	  		state[7] := 15;
	  	ELSIF state[7] = 15 & NOT INTERN_3 THEN (* R2-NOT-PERMITTED *)
	  		state[7] := 18;
	  	ELSIF state[7] = 16 & NOT GD_OUT_10 THEN (* M1-REPAIR-OUT-OFF *)
	  		state[7] := 0;
	  	ELSIF state[7] = 17 & NOT GD_OUT_11 THEN (* M2-REPAIR-OUT-OFF *)
	  		state[7] := 0;
	  	ELSIF state[7] = 19 & NOT GD_OUT_11 THEN (* M2-REPAIR-OUT-OFF *)
	  		state[7] := 1;
	  	END_IF;
	
		(* ===== Pairs: they turn an internal request into an order ===== *)
		(* pair (e2, M2-ON): the request switches the order on and is cleared once the order is on *)
		IF NOT GD_OUT_1 & INTERN_1 THEN
			GD_OUT_1 := 1;
		ELSIF GD_OUT_1 & INTERN_1 THEN
			INTERN_1 := 0;
			INTERN_1_G[0] := 0;
	END_IF;
		(* pair (e1, M1-ON): the request switches the order on and is cleared once the order is on *)
		IF NOT GD_OUT_0 & INTERN_0 THEN
			GD_OUT_0 := 1;
		ELSIF GD_OUT_0 & INTERN_0 THEN
			INTERN_0 := 0;
			INTERN_0_G[0] := 0;
	END_IF;
		(* ===== Copies of signals to other outputs (Mask) ===== *)
		GD_OUT_3 := GD_OUT_2;
	 	GD_OUT_8 := NOT GD_IN_10;
	 	GD_OUT_9 := NOT GD_IN_11;
	 
	END_IF;
END_PROGRAM

