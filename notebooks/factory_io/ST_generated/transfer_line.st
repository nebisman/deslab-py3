(* OpenPLC random number (C code), used to pick one of several orders *)
FUNCTION_BLOCK random_number
	VAR_INPUT
		IN : BOOL;
	END_VAR
	VAR
		M : BOOL;
		INIT : BOOL;
	END_VAR
	VAR_OUTPUT
		OUT : DINT;
	END_VAR

	IF INIT = 0 THEN
		{#include <stdio.h>}
		{#include <stdlib.h>}
		IN := 1;
	END_IF;
	IF M = 0 and IN = 1 THEN
		{SetFbVar(OUT,rand())}
	END_IF;
END_FUNCTION_BLOCK
(* Controller generated by DESlab (generate_ST_OPENPLC). Every scan it: *)
(* 1. computes the input edges and a random number *)
(* 2. waits for the start signal (start); from then on it runs the next steps every scan *)
(* 3. each automaton moves with at most one uncontrollable event *)
(* 4. each automaton writes the orders enabled in its state; if there are several, it picks one at random *)
(* 5. an order shared by several supervisors changes only if all of them propose it *)
(* 6. each automaton moves with the order that was given (controllable event) *)
(* 7. pairs turn internal requests into orders *)
(* 8. copies signals to other outputs (Mask) *)
(* The states of each automaton are numbered from 0, its initial state: *)
(* state[0]: supervisor sup_2 *)
(* state[1]: supervisor sup2_2 *)
(* state[2]: auxiliary automaton sup_M1 *)
(* state[3]: auxiliary automaton sup_B1 *)
(* state[4]: auxiliary automaton M2 *)
(* state[5]: auxiliary automaton sup_B2 *)
(* state[6]: auxiliary automaton sup_TU *)
(* state[7]: auxiliary automaton Pyp *)
(* state[8]: coordinator of supervisors sup_2 and sup2_2 *)
PROGRAM supcon
	VAR
		(* Internal variables *)
		random : random_number; (* random number generator *)
		random_num : DINT; (* random number of this scan *)
		initial : BOOL; (* 1 once the start signal (start) has arrived *)
		state : ARRAY [0..9] OF DINT; (* state of each automaton; the list is at the start of the program *)
		aux : BOOL := 0; (* agreed proposal of a request supervised by a coordinator *)
		INTERN_1_C : ARRAY [0..1] OF BOOL; (* coordinator of supervisors sup_2 and sup2_2: [1] allows setting INTERN_1 to 1, [0] allows setting it to 0 *)
		INTERN_3_C : ARRAY [0..1] OF BOOL; (* coordinator of supervisors sup_2 and sup2_2: [1] allows setting INTERN_3 to 1, [0] allows setting it to 0 *)
		INTERN_5_C : ARRAY [0..1] OF BOOL; (* coordinator of supervisors sup_2 and sup2_2: [1] allows setting INTERN_5 to 1, [0] allows setting it to 0 *)
		slt0 : ARRAY [0..2] OF DINT; (* random choices of supervisor sup_2, one per state with several orders *)
		INTERN_3_G : ARRAY [0..2] OF BOOL; (* proposals of INTERN_3 from [0] supervisor sup_2, [1] supervisor sup2_2 *)
		INTERN_5_G : ARRAY [0..2] OF BOOL; (* proposals of INTERN_5 from [0] supervisor sup_2, [1] supervisor sup2_2 *)
		INTERN_1_G : ARRAY [0..1] OF BOOL; (* proposals of INTERN_1 from [0] supervisor sup_2 *)
		RE_M1 : R_TRIG; (* rising edge of GD_IN_1: event 2 *)
		FE_M2E : F_TRIG; (* falling edge of GD_IN_6: M2-END *)
		FE_CP : F_TRIG; (* falling edge of GD_IN_7: Piece-at-review *)
		RE_CP : R_TRIG; (* rising edge of GD_IN_7: Piece-at-TU *)
		FE_M1 : F_TRIG; (* falling edge of GD_IN_1: M1-arrived *)
		FE_B1 : F_TRIG; (* falling edge of GD_IN_3: Piece-at-buffer *)
		FE_B1O : F_TRIG; (* falling edge of GD_IN_5: Buffer-out *)
		FE_PO : F_TRIG; (* falling edge of GD_IN_9: Piece-out *)
		FE_PR : F_TRIG; (* falling edge of GD_IN_11: Piece-reprocessed *)
		FE_AT : F_TRIG; (* falling edge of GD_IN_10: Piece-at-PyP *)
		FE_MZ : F_TRIG; (* falling edge of GD_IN_12: Moving-Z *)
		FE_RO : F_TRIG; (* falling edge of GD_IN_13: Rotating *)
		INTERN_1 : BOOL; (* internal variable; 1 for event 1 *)
		INTERN_3 : BOOL; (* internal variable; 1 for event 3 *)
		INTERN_5 : BOOL; (* internal variable; 1 for event 5 *)
	END_VAR
	VAR
		(* PLC inputs and outputs *)
		GD_OUT_1 AT %QX100.1 : BOOL; (* output; copy of GD_OUT_0 (Mask) *)
 		GD_OUT_2 AT %QX100.2 : BOOL; (* output; copy of GD_OUT_0 (Mask) *)
 		GD_OUT_3 AT %QX100.3 : BOOL; (* output; copy of GD_OUT_0 (Mask) *)
 		GD_OUT_11 AT %QX101.3 : BOOL; (* output; copy of GD_OUT_10 (Mask) *)
 		GD_OUT_12 AT %QX101.4 : BOOL; (* output; copy of GD_OUT_10 (Mask) *)
 		GD_OUT_13 AT %QX101.5 : BOOL; (* output; copy of GD_OUT_10 (Mask) *)
 		GD_OUT_14 AT %QX101.6 : BOOL; (* output; copy of GD_OUT_10 (Mask) *)
 		GD_IN_0 AT %IX100.0 : BOOL; (* input; 1 for start *)
		GD_IN_8 AT %IX101.0 : BOOL; (* input; 1 for Piece-right; 0 for Piece-wrong *)
		GD_IN_1 AT %IX100.1 : BOOL; (* input; rising edge (RE_M1): event 2; falling edge (FE_M1): M1-arrived *)
		GD_IN_6 AT %IX100.6 : BOOL; (* input; 1 for M2-Busy; falling edge (FE_M2E): M2-END *)
		GD_OUT_7 AT %QX100.7 : BOOL; (* output; 1 for M2-ON; 0 for M2-OFF *)
		GD_IN_7 AT %IX100.7 : BOOL; (* input; falling edge (FE_CP): Piece-at-review; rising edge (RE_CP): Piece-at-TU *)
		GD_OUT_4 AT %QX100.4 : BOOL; (* output; 1 for Clamp-on; 0 for Clamp-off *)
		GD_IN_2 AT %IX100.2 : BOOL; (* input; 1 for Clamped *)
		GD_IN_3 AT %IX100.3 : BOOL; (* input; falling edge (FE_B1): Piece-at-buffer *)
		GD_OUT_5 AT %QX100.5 : BOOL; (* output; 1 for BUFFER-Conveyor-ON; 0 for BUFFER-Conveyor-OFF *)
		GD_OUT_6 AT %QX100.6 : BOOL; (* output; 1 for BLADE-ON; 0 for BLADE-OFF *)
		GD_IN_4 AT %IX100.4 : BOOL; (* input; 1 for BLADE-LIMIT *)
		GD_IN_5 AT %IX100.5 : BOOL; (* input; falling edge (FE_B1O): Buffer-out *)
		GD_OUT_8 AT %QX101.0 : BOOL; (* output; 1 for BUFFER2-Conveyor-ON; 0 for BUFFER2-Conveyor-OFF *)
		GD_OUT_9 AT %QX101.1 : BOOL; (* output; 1 for TU-Conveyor-ON; 0 for TU-Conveyor-OFF *)
		GD_OUT_10 AT %QX101.2 : BOOL; (* output; 1 for TU-ARM-ON; 0 for TU-ARM-OFF *)
		GD_IN_9 AT %IX101.1 : BOOL; (* input; falling edge (FE_PO): Piece-out *)
		GD_IN_11 AT %IX101.3 : BOOL; (* input; falling edge (FE_PR): Piece-reprocessed *)
		GD_IN_10 AT %IX101.2 : BOOL; (* input; falling edge (FE_AT): Piece-at-PyP *)
		GD_IN_12 AT %IX101.4 : BOOL; (* input; falling edge (FE_MZ): Moving-Z *)
		GD_IN_13 AT %IX101.5 : BOOL; (* input; falling edge (FE_RO): Rotating *)
		GD_OUT_15 AT %QX101.7 : BOOL; (* output; 1 for Z-ON; 0 for Z-OFF *)
		GD_OUT_18 AT %QX102.2 : BOOL; (* output; 1 for GRAB-ON; 0 for GRAB-OFF *)
		GD_OUT_16 AT %QX102.0 : BOOL; (* output; 1 for Rotate+-ON; 0 for Rotate+-OFF *)
		GD_OUT_17 AT %QX102.1 : BOOL; (* output; 1 for Rotate--ON; 0 for Rotate--OFF *)
		GD_OUT_0 AT %QX100.0 : BOOL; (* output; 1 for M1-Conveyor-ON; 0 for M1-Conveyor-OFF *)
	END_VAR
	(* Input edges *)
	RE_M1(CLK:= GD_IN_1); (* event 2 *)
	FE_M2E(CLK:= GD_IN_6); (* M2-END *)
	FE_CP(CLK:= GD_IN_7); (* Piece-at-review *)
	RE_CP(CLK:= GD_IN_7); (* Piece-at-TU *)
	FE_M1(CLK:= GD_IN_1); (* M1-arrived *)
	FE_B1(CLK:= GD_IN_3); (* Piece-at-buffer *)
	FE_B1O(CLK:= GD_IN_5); (* Buffer-out *)
	FE_PO(CLK:= GD_IN_9); (* Piece-out *)
	FE_PR(CLK:= GD_IN_11); (* Piece-reprocessed *)
	FE_AT(CLK:= GD_IN_10); (* Piece-at-PyP *)
	FE_MZ(CLK:= GD_IN_12); (* Moving-Z *)
	FE_RO(CLK:= GD_IN_13); (* Rotating *)
	(* Random number of this scan *)
	random(
		IN := True,
		OUT => random_num);
	(* Waits for the start signal (start); from then on it runs the controller every scan *)
	IF NOT initial THEN
		IF GD_IN_0 THEN
			initial := 1;
		END_IF;
	ELSIF initial THEN (* controller *)
		(* ===== Uncontrollable events: each automaton moves with at most one per scan ===== *)
		(* supervisor sup_2 (state[0]): uncontrollable transitions *)
		IF state[0] = 0 & GD_IN_0 THEN (* start *)
	  		state[0] := 1;
	  	ELSIF state[0] = 2 & RE_M1.Q THEN (* event 2 *)
	  		state[0] := 4;
	  	ELSIF state[0] = 3 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[0] := 4;
	  	ELSIF state[0] = 3 & FE_PO.Q THEN (* Piece-out *)
	  		state[0] := 1;
	  	ELSIF state[0] = 5 & RE_CP.Q THEN (* Piece-at-TU *)
	  		state[0] := 1;
	  	ELSIF state[0] = 6 & RE_M1.Q THEN (* event 2 *)
	  		state[0] := 8;
	  	ELSIF state[0] = 6 & RE_CP.Q THEN (* Piece-at-TU *)
	  		state[0] := 2;
	  	ELSIF state[0] = 7 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[0] := 8;
	  	ELSIF state[0] = 7 & RE_CP.Q THEN (* Piece-at-TU *)
	  		state[0] := 3;
	  	ELSIF state[0] = 7 & FE_PO.Q THEN (* Piece-out *)
	  		state[0] := 5;
	  	ELSIF state[0] = 8 & RE_CP.Q THEN (* Piece-at-TU *)
	  		state[0] := 4;
	  	END_IF;
	
		(* supervisor sup2_2 (state[1]): uncontrollable transitions *)
		IF state[1] = 1 & RE_CP.Q THEN (* Piece-at-TU *)
	  		state[1] := 2;
	  	ELSIF state[1] = 3 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[1] := 0;
	  	ELSIF state[1] = 3 & FE_PO.Q THEN (* Piece-out *)
	  		state[1] := 0;
	  	ELSIF state[1] = 4 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[1] := 1;
	  	ELSIF state[1] = 4 & RE_CP.Q THEN (* Piece-at-TU *)
	  		state[1] := 5;
	  	ELSIF state[1] = 4 & FE_PO.Q THEN (* Piece-out *)
	  		state[1] := 1;
	  	ELSIF state[1] = 5 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[1] := 2;
	  	ELSIF state[1] = 5 & FE_PO.Q THEN (* Piece-out *)
	  		state[1] := 2;
	  	END_IF;
	
		(* auxiliary automaton sup_M1 (state[2]): uncontrollable transitions *)
		IF state[2] = 0 & GD_OUT_0 THEN (* M1-Conveyor-ON *)
	  		state[2] := 1;
	  	ELSIF state[2] = 0 & FE_M1.Q THEN (* M1-arrived *)
	  		state[2] := 2;
	  	ELSIF state[2] = 1 & FE_M1.Q THEN (* M1-arrived *)
	  		state[2] := 3;
	  	ELSIF state[2] = 2 & GD_OUT_0 THEN (* M1-Conveyor-ON *)
	  		state[2] := 3;
	  	END_IF;
	
		(* auxiliary automaton sup_B1 (state[3]): uncontrollable transitions *)
		IF state[3] = 0 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 1;
	  	ELSIF state[3] = 0 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 1;
	  	ELSIF state[3] = 2 & FE_B1.Q THEN (* Piece-at-buffer *)
	  		state[3] := 3;
	  	ELSIF state[3] = 2 & FE_B1O.Q THEN (* Buffer-out *)
	  		state[3] := 4;
	  	ELSIF state[3] = 3 & FE_B1O.Q THEN (* Buffer-out *)
	  		state[3] := 5;
	  	ELSIF state[3] = 4 & FE_B1.Q THEN (* Piece-at-buffer *)
	  		state[3] := 5;
	  	ELSIF state[3] = 4 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 7;
	  	ELSIF state[3] = 4 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 7;
	  	ELSIF state[3] = 5 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 8;
	  	ELSIF state[3] = 5 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 8;
	  	ELSIF state[3] = 6 & FE_B1O.Q THEN (* Buffer-out *)
	  		state[3] := 9;
	  	ELSIF state[3] = 7 & FE_B1.Q THEN (* Piece-at-buffer *)
	  		state[3] := 8;
	  	ELSIF state[3] = 9 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 11;
	  	ELSIF state[3] = 9 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 11;
	  	ELSIF state[3] = 10 & GD_IN_2 THEN (* Clamped *)
	  		state[3] := 13;
	  	ELSIF state[3] = 10 & FE_B1O.Q THEN (* Buffer-out *)
	  		state[3] := 12;
	  	ELSIF state[3] = 12 & GD_IN_2 THEN (* Clamped *)
	  		state[3] := 15;
	  	ELSIF state[3] = 12 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 14;
	  	ELSIF state[3] = 12 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 14;
	  	ELSIF state[3] = 13 & FE_B1O.Q THEN (* Buffer-out *)
	  		state[3] := 15;
	  	ELSIF state[3] = 14 & GD_IN_2 THEN (* Clamped *)
	  		state[3] := 17;
	  	ELSIF state[3] = 15 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 17;
	  	ELSIF state[3] = 15 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 17;
	  	ELSIF state[3] = 16 & FE_B1O.Q THEN (* Buffer-out *)
	  		state[3] := 18;
	  	ELSIF state[3] = 18 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 20;
	  	ELSIF state[3] = 18 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 20;
	  	ELSIF state[3] = 19 & FE_B1O.Q THEN (* Buffer-out *)
	  		state[3] := 21;
	  	ELSIF state[3] = 21 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 23;
	  	ELSIF state[3] = 21 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 23;
	  	ELSIF state[3] = 22 & FE_B1O.Q THEN (* Buffer-out *)
	  		state[3] := 24;
	  	ELSIF state[3] = 24 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 26;
	  	ELSIF state[3] = 24 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 26;
	  	ELSIF state[3] = 25 & FE_B1O.Q THEN (* Buffer-out *)
	  		state[3] := 27;
	  	ELSIF state[3] = 27 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 28;
	  	ELSIF state[3] = 27 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 28;
	  	ELSIF state[3] = 29 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 30;
	  	ELSIF state[3] = 29 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 30;
	  	ELSIF state[3] = 31 & RE_M1.Q THEN (* event 2 *)
	  		state[3] := 32;
	  	ELSIF state[3] = 31 & FE_PR.Q THEN (* Piece-reprocessed *)
	  		state[3] := 32;
	  	END_IF;
	
		(* auxiliary automaton M2 (state[4]): uncontrollable transitions *)
		IF state[4] = 0 & GD_OUT_7 THEN (* M2-ON *)
	  		state[4] := 1;
	  	ELSIF state[4] = 1 & GD_IN_6 THEN (* M2-Busy *)
	  		state[4] := 2;
	  	ELSIF state[4] = 3 & FE_M2E.Q THEN (* M2-END *)
	  		state[4] := 0;
	  	END_IF;
	
		(* auxiliary automaton sup_B2 (state[5]): uncontrollable transitions *)
		IF state[5] = 0 & GD_IN_6 THEN (* M2-Busy *)
	  		state[5] := 1;
	  	ELSIF state[5] = 1 & FE_M2E.Q THEN (* M2-END *)
	  		state[5] := 2;
	  	ELSIF state[5] = 3 & RE_CP.Q THEN (* Piece-at-TU *)
	  		state[5] := 4;
	  	END_IF;
	
		(* auxiliary automaton sup_TU (state[6]): uncontrollable transitions *)
		IF state[6] = 0 & GD_OUT_9 THEN (* TU-Conveyor-ON *)
	  		state[6] := 1;
	  	ELSIF state[6] = 1 & FE_CP.Q THEN (* Piece-at-review *)
	  		state[6] := 2;
	  	ELSIF state[6] = 2 & GD_IN_8 THEN (* Piece-right *)
	  		state[6] := 3;
	  	ELSIF state[6] = 2 & NOT GD_IN_8 THEN (* Piece-wrong *)
	  		state[6] := 4;
	  	ELSIF state[6] = 3 & FE_PO.Q THEN (* Piece-out *)
	  		state[6] := 5;
	  	ELSIF state[6] = 6 & FE_AT.Q THEN (* Piece-at-PyP *)
	  		state[6] := 7;
	  	END_IF;
	
		(* auxiliary automaton Pyp (state[7]): uncontrollable transitions *)
		IF state[7] = 0 & FE_AT.Q THEN (* Piece-at-PyP *)
	  		state[7] := 1;
	  	ELSIF state[7] = 2 & FE_MZ.Q THEN (* Moving-Z *)
	  		state[7] := 3;
	  	ELSIF state[7] = 5 & FE_MZ.Q THEN (* Moving-Z *)
	  		state[7] := 6;
	  	ELSIF state[7] = 7 & FE_RO.Q THEN (* Rotating *)
	  		state[7] := 8;
	  	ELSIF state[7] = 10 & FE_MZ.Q THEN (* Moving-Z *)
	  		state[7] := 11;
	  	ELSIF state[7] = 13 & FE_MZ.Q THEN (* Moving-Z *)
	  		state[7] := 14;
	  	ELSIF state[7] = 15 & FE_RO.Q THEN (* Rotating *)
	  		state[7] := 16;
	  	END_IF;
	
		(* ===== Orders: each automaton writes the orders enabled in its state; if there are several, it picks one at random ===== *)
	
		(* supervisor sup_2 (state[0]): orders of each state *)
		CASE state[0] OF
	  		1:
	  			CASE slt0[0] OF (* one of 2 orders, at random *)
	  				0:
	  					INTERN_1_G[0] := 1; (* event 1 *)
	  				1:
	  					INTERN_5_G[0] := 1; (* event 5 *)
	  			END_CASE;
	  			slt0[0] := (random_num + slt0[0]) MOD 2;
	  			random_num := random_num - slt0[0];
	 		4:
	  			INTERN_3_G[0] := 1; (* event 3 *)
			5:
	  			CASE slt0[1] OF (* one of 2 orders, at random *)
	  				0:
	  					INTERN_1_G[0] := 1; (* event 1 *)
	  				1:
	  					INTERN_5_G[0] := 1; (* event 5 *)
	  			END_CASE;
	  			slt0[1] := (random_num + slt0[1]) MOD 2;
	  			random_num := random_num - slt0[1];
	 	END_CASE;
	
		(* supervisor sup2_2 (state[1]): orders of each state *)
		CASE state[1] OF
	  		0:
	  			INTERN_3_G[1] := 1; (* event 3 *)
			2:
	  			INTERN_5_G[1] := 1; (* event 5 *)
			3:
	  			INTERN_3_G[1] := 1; (* event 3 *)
		END_CASE;
	
		(* auxiliary automaton sup_M1 (state[2]): orders of each state *)
		CASE state[2] OF
	  		3:
	  			GD_OUT_0 := 0; (* M1-Conveyor-OFF *)
	  	END_CASE;
	
		(* auxiliary automaton sup_B1 (state[3]): orders of each state *)
		CASE state[3] OF
	  		1:
	  			GD_OUT_5 := 1; (* BUFFER-Conveyor-ON *)
			3:
	  			GD_OUT_5 := 0; (* BUFFER-Conveyor-OFF *)
	  		5:
	  			GD_OUT_5 := 0; (* BUFFER-Conveyor-OFF *)
	  		6:
	  			GD_OUT_4 := 1; (* Clamp-on *)
			8:
	  			GD_OUT_5 := 0; (* BUFFER-Conveyor-OFF *)
	  		9:
	  			GD_OUT_4 := 1; (* Clamp-on *)
			11:
	  			GD_OUT_4 := 1; (* Clamp-on *)
			13:
	  			GD_OUT_4 := 0; (* Clamp-off *)
	  		15:
	  			GD_OUT_4 := 0; (* Clamp-off *)
	  		16:
	  			GD_OUT_6 := 1; (* BLADE-ON *)
			17:
	  			GD_OUT_4 := 0; (* Clamp-off *)
	  		18:
	  			GD_OUT_6 := 1; (* BLADE-ON *)
			19:
	  			GD_IN_4 := 1; (* BLADE-LIMIT *)
			20:
	  			GD_OUT_6 := 1; (* BLADE-ON *)
			21:
	  			GD_IN_4 := 1; (* BLADE-LIMIT *)
			22:
	  			GD_OUT_5 := 1; (* BUFFER-Conveyor-ON *)
			23:
	  			GD_IN_4 := 1; (* BLADE-LIMIT *)
			26:
	  			GD_OUT_5 := 1; (* BUFFER-Conveyor-ON *)
			27:
	  			GD_OUT_5 := 0; (* BUFFER-Conveyor-OFF *)
	  		28:
	  			GD_OUT_5 := 0; (* BUFFER-Conveyor-OFF *)
	  		29:
	  			GD_OUT_6 := 0; (* BLADE-OFF *)
	  		30:
	  			GD_OUT_6 := 0; (* BLADE-OFF *)
	  		31:
	  			GD_IN_4 := 1; (* BLADE-LIMIT *)
			32:
	  			GD_IN_4 := 1; (* BLADE-LIMIT *)
		END_CASE;
	
		(* auxiliary automaton M2 (state[4]): orders of each state *)
		CASE state[4] OF
	  		2:
	  			GD_OUT_7 := 0; (* M2-OFF *)
	  	END_CASE;
	
		(* auxiliary automaton sup_B2 (state[5]): orders of each state *)
		CASE state[5] OF
	  		2:
	  			GD_OUT_8 := 1; (* BUFFER2-Conveyor-ON *)
			4:
	  			GD_OUT_8 := 0; (* BUFFER2-Conveyor-OFF *)
	  	END_CASE;
	
		(* auxiliary automaton sup_TU (state[6]): orders of each state *)
		CASE state[6] OF
	  		4:
	  			GD_OUT_10 := 1; (* TU-ARM-ON *)
			5:
	  			GD_OUT_9 := 0; (* TU-Conveyor-OFF *)
	  		7:
	  			GD_OUT_10 := 0; (* TU-ARM-OFF *)
	  		8:
	  			GD_OUT_9 := 0; (* TU-Conveyor-OFF *)
	  	END_CASE;
	
		(* auxiliary automaton Pyp (state[7]): orders of each state *)
		CASE state[7] OF
	  		1:
	  			GD_OUT_15 := 1; (* Z-ON *)
			3:
	  			GD_OUT_18 := 1; (* GRAB-ON *)
			4:
	  			GD_OUT_15 := 0; (* Z-OFF *)
	  		6:
	  			GD_OUT_16 := 1; (* Rotate+-ON *)
			8:
	  			GD_OUT_16 := 0; (* Rotate+-OFF *)
	  		9:
	  			GD_OUT_15 := 1; (* Z-ON *)
			11:
	  			GD_OUT_18 := 0; (* GRAB-OFF *)
	  		12:
	  			GD_OUT_15 := 0; (* Z-OFF *)
	  		14:
	  			GD_OUT_17 := 1; (* Rotate--ON *)
			16:
	  			GD_OUT_17 := 0; (* Rotate--OFF *)
	  	END_CASE;
		(* coordinator of supervisors sup_2 and sup2_2 (state[8]): requests it allows (1) or not (0) in each state *)
		CASE state[8] OF
	  		0:
	  			INTERN_1_C[1] := 1; (* allows event 1 *)
				INTERN_3_C[1] := 1; (* allows event 3 *)
				INTERN_5_C[1] := 0; (* does not allow event 5 *)
			1:
	  			INTERN_1_C[1] := 0; (* does not allow event 1 *)
				INTERN_3_C[1] := 0; (* does not allow event 3 *)
				INTERN_5_C[1] := 1; (* allows event 5 *)
		END_CASE;
		(* ===== Shared orders: they change only if every supervisor that shares them proposes them ===== *)
		(* INTERN_3 (1 for event 3): proposals INTERN_3_G of [0] supervisor sup_2, [1] supervisor sup2_2; supervised by a coordinator *)
	  	IF INTERN_3_G[0] <> INTERN_3_G[1] THEN
			INTERN_3_G[0] := INTERN_3;
			INTERN_3_G[1] := INTERN_3;
		END_IF;
		aux := INTERN_3_G[0];
		IF aux XOR INTERN_3 THEN
			IF NOT aux & INTERN_3_C[0] THEN
				INTERN_3 := 0;
			ELSIF aux & INTERN_3_C[1] THEN
				INTERN_3 := 1;
			END_IF;
		END_IF;
		INTERN_3_G[0] := INTERN_3;
		(* INTERN_5 (1 for event 5): proposals INTERN_5_G of [0] supervisor sup_2, [1] supervisor sup2_2; supervised by a coordinator *)
		IF INTERN_5_G[0] <> INTERN_5_G[1] THEN
			INTERN_5_G[0] := INTERN_5;
			INTERN_5_G[1] := INTERN_5;
		END_IF;
		aux := INTERN_5_G[0];
		IF aux XOR INTERN_5 THEN
			IF NOT aux & INTERN_5_C[0] THEN
				INTERN_5 := 0;
			ELSIF aux & INTERN_5_C[1] THEN
				INTERN_5 := 1;
			END_IF;
		END_IF;
		INTERN_5_G[0] := INTERN_5;
		(* INTERN_1 (1 for event 1): proposals INTERN_1_G of [0] supervisor sup_2; supervised by a coordinator *)
	
		aux := INTERN_1_G[0];
		IF aux XOR INTERN_1 THEN
			IF NOT aux & INTERN_1_C[0] THEN
				INTERN_1 := 0;
			ELSIF aux & INTERN_1_C[1] THEN
				INTERN_1 := 1;
			END_IF;
		END_IF;
		INTERN_1_G[0] := INTERN_1;
		(* coordinator of supervisors sup_2 and sup2_2 (state[8]): transitions with the allowed requests *)
		IF state[8] = 0 & INTERN_3 THEN (* event 3 *)
	  		state[8] := 1;
	  	ELSIF state[8] = 1 & INTERN_5 THEN (* event 5 *)
	  		state[8] := 0;
	  	END_IF;
		(* ===== Orders given: each automaton moves with the controllable event of the order ===== *)
		(* supervisor sup_2 (state[0]): controllable transitions *)
		IF state[0] = 1 & INTERN_1 THEN (* event 1 *)
	  		state[0] := 2;
	  	ELSIF state[0] = 1 & INTERN_5 THEN (* event 5 *)
	  		state[0] := 3;
	  	ELSIF state[0] = 4 & INTERN_3 THEN (* event 3 *)
	  		state[0] := 5;
	  	ELSIF state[0] = 5 & INTERN_1 THEN (* event 1 *)
	  		state[0] := 6;
	  	ELSIF state[0] = 5 & INTERN_5 THEN (* event 5 *)
	  		state[0] := 7;
	  	END_IF;
	
		(* supervisor sup2_2 (state[1]): controllable transitions *)
		IF state[1] = 0 & INTERN_3 THEN (* event 3 *)
	  		state[1] := 1;
	  	ELSIF state[1] = 2 & INTERN_5 THEN (* event 5 *)
	  		state[1] := 3;
	  	ELSIF state[1] = 3 & INTERN_3 THEN (* event 3 *)
	  		state[1] := 4;
	  	END_IF;
	
		(* auxiliary automaton sup_M1 (state[2]): controllable transitions *)
		IF state[2] = 3 & NOT GD_OUT_0 THEN (* M1-Conveyor-OFF *)
	  		state[2] := 0;
	  	END_IF;
	
		(* auxiliary automaton sup_B1 (state[3]): controllable transitions *)
		IF state[3] = 1 & GD_OUT_5 THEN (* BUFFER-Conveyor-ON *)
	  		state[3] := 2;
	  	ELSIF state[3] = 3 & NOT GD_OUT_5 THEN (* BUFFER-Conveyor-OFF *)
	  		state[3] := 6;
	  	ELSIF state[3] = 5 & NOT GD_OUT_5 THEN (* BUFFER-Conveyor-OFF *)
	  		state[3] := 9;
	  	ELSIF state[3] = 6 & GD_OUT_4 THEN (* Clamp-on *)
	  		state[3] := 10;
	  	ELSIF state[3] = 8 & NOT GD_OUT_5 THEN (* BUFFER-Conveyor-OFF *)
	  		state[3] := 11;
	  	ELSIF state[3] = 9 & GD_OUT_4 THEN (* Clamp-on *)
	  		state[3] := 12;
	  	ELSIF state[3] = 11 & GD_OUT_4 THEN (* Clamp-on *)
	  		state[3] := 14;
	  	ELSIF state[3] = 13 & NOT GD_OUT_4 THEN (* Clamp-off *)
	  		state[3] := 16;
	  	ELSIF state[3] = 15 & NOT GD_OUT_4 THEN (* Clamp-off *)
	  		state[3] := 18;
	  	ELSIF state[3] = 16 & GD_OUT_6 THEN (* BLADE-ON *)
	  		state[3] := 19;
	  	ELSIF state[3] = 17 & NOT GD_OUT_4 THEN (* Clamp-off *)
	  		state[3] := 20;
	  	ELSIF state[3] = 18 & GD_OUT_6 THEN (* BLADE-ON *)
	  		state[3] := 21;
	  	ELSIF state[3] = 19 & GD_IN_4 THEN (* BLADE-LIMIT *)
	  		state[3] := 22;
	  	ELSIF state[3] = 20 & GD_OUT_6 THEN (* BLADE-ON *)
	  		state[3] := 23;
	  	ELSIF state[3] = 21 & GD_IN_4 THEN (* BLADE-LIMIT *)
	  		state[3] := 24;
	  	ELSIF state[3] = 22 & GD_OUT_5 THEN (* BUFFER-Conveyor-ON *)
	  		state[3] := 25;
	  	ELSIF state[3] = 23 & GD_IN_4 THEN (* BLADE-LIMIT *)
	  		state[3] := 26;
	  	ELSIF state[3] = 26 & GD_OUT_5 THEN (* BUFFER-Conveyor-ON *)
	  		state[3] := 25;
	  	ELSIF state[3] = 27 & NOT GD_OUT_5 THEN (* BUFFER-Conveyor-OFF *)
	  		state[3] := 29;
	  	ELSIF state[3] = 28 & NOT GD_OUT_5 THEN (* BUFFER-Conveyor-OFF *)
	  		state[3] := 30;
	  	ELSIF state[3] = 29 & NOT GD_OUT_6 THEN (* BLADE-OFF *)
	  		state[3] := 31;
	  	ELSIF state[3] = 30 & NOT GD_OUT_6 THEN (* BLADE-OFF *)
	  		state[3] := 32;
	  	ELSIF state[3] = 31 & GD_IN_4 THEN (* BLADE-LIMIT *)
	  		state[3] := 0;
	  	ELSIF state[3] = 32 & GD_IN_4 THEN (* BLADE-LIMIT *)
	  		state[3] := 1;
	  	END_IF;
	
		(* auxiliary automaton M2 (state[4]): controllable transitions *)
		IF state[4] = 2 & NOT GD_OUT_7 THEN (* M2-OFF *)
	  		state[4] := 3;
	  	END_IF;
	
		(* auxiliary automaton sup_B2 (state[5]): controllable transitions *)
		IF state[5] = 2 & GD_OUT_8 THEN (* BUFFER2-Conveyor-ON *)
	  		state[5] := 3;
	  	ELSIF state[5] = 4 & NOT GD_OUT_8 THEN (* BUFFER2-Conveyor-OFF *)
	  		state[5] := 0;
	  	END_IF;
	
		(* auxiliary automaton sup_TU (state[6]): controllable transitions *)
		IF state[6] = 4 & GD_OUT_10 THEN (* TU-ARM-ON *)
	  		state[6] := 6;
	  	ELSIF state[6] = 5 & NOT GD_OUT_9 THEN (* TU-Conveyor-OFF *)
	  		state[6] := 0;
	  	ELSIF state[6] = 7 & NOT GD_OUT_10 THEN (* TU-ARM-OFF *)
	  		state[6] := 8;
	  	ELSIF state[6] = 8 & NOT GD_OUT_9 THEN (* TU-Conveyor-OFF *)
	  		state[6] := 0;
	  	END_IF;
	
		(* auxiliary automaton Pyp (state[7]): controllable transitions *)
		IF state[7] = 1 & GD_OUT_15 THEN (* Z-ON *)
	  		state[7] := 2;
	  	ELSIF state[7] = 3 & GD_OUT_18 THEN (* GRAB-ON *)
	  		state[7] := 4;
	  	ELSIF state[7] = 4 & NOT GD_OUT_15 THEN (* Z-OFF *)
	  		state[7] := 5;
	  	ELSIF state[7] = 6 & GD_OUT_16 THEN (* Rotate+-ON *)
	  		state[7] := 7;
	  	ELSIF state[7] = 8 & NOT GD_OUT_16 THEN (* Rotate+-OFF *)
	  		state[7] := 9;
	  	ELSIF state[7] = 9 & GD_OUT_15 THEN (* Z-ON *)
	  		state[7] := 10;
	  	ELSIF state[7] = 11 & NOT GD_OUT_18 THEN (* GRAB-OFF *)
	  		state[7] := 12;
	  	ELSIF state[7] = 12 & NOT GD_OUT_15 THEN (* Z-OFF *)
	  		state[7] := 13;
	  	ELSIF state[7] = 14 & GD_OUT_17 THEN (* Rotate--ON *)
	  		state[7] := 15;
	  	ELSIF state[7] = 16 & NOT GD_OUT_17 THEN (* Rotate--OFF *)
	  		state[7] := 0;
	  	END_IF;
	
		(* ===== Pairs: they turn an internal request into an order ===== *)
		(* pair (event 1, M1-Conveyor-ON): the request switches the order on and is cleared once the order is on *)
		IF NOT GD_OUT_0 & INTERN_1 THEN
			GD_OUT_0 := 1;
		ELSIF GD_OUT_0 & INTERN_1 THEN
			INTERN_1 := 0;
			INTERN_1_G[0] := 0;
	END_IF;
		(* pair (event 3, M2-ON): the request switches the order on and is cleared once the order is on *)
		IF NOT GD_OUT_7 & INTERN_3 THEN
			GD_OUT_7 := 1;
		ELSIF GD_OUT_7 & INTERN_3 THEN
			INTERN_3 := 0;
			INTERN_3_G[0] := 0;
	END_IF;
		(* pair (event 5, TU-Conveyor-ON): the request switches the order on and is cleared once the order is on *)
		IF NOT GD_OUT_9 & INTERN_5 THEN
			GD_OUT_9 := 1;
		ELSIF GD_OUT_9 & INTERN_5 THEN
			INTERN_5 := 0;
			INTERN_5_G[0] := 0;
	END_IF;
		(* ===== Copies of signals to other outputs (Mask) ===== *)
		GD_OUT_1 := GD_OUT_0;
	 	GD_OUT_2 := GD_OUT_0;
	 	GD_OUT_3 := GD_OUT_0;
	 	GD_OUT_11 := GD_OUT_10;
	 	GD_OUT_12 := GD_OUT_10;
	 	GD_OUT_13 := GD_OUT_10;
	 	GD_OUT_14 := GD_OUT_10;
	 
	END_IF;
END_PROGRAM

