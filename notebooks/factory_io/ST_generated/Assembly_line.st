(* OpenPLC random number (C code), used to pick one of several orders *)
FUNCTION_BLOCK random_number
	VAR_INPUT
		IN : BOOL;
	END_VAR
	VAR
		M : BOOL;
		INIT : BOOL;
	END_VAR
	VAR_OUTPUT
		OUT : DINT;
	END_VAR

	IF INIT = 0 THEN
		{#include <stdio.h>}
		{#include <stdlib.h>}
		IN := 1;
	END_IF;
	IF M = 0 and IN = 1 THEN
		{SetFbVar(OUT,rand())}
	END_IF;
END_FUNCTION_BLOCK
(* Controller generated by DESlab (generate_ST_OPENPLC). Every scan it: *)
(* 1. computes the input edges and a random number *)
(* 2. during the first second after the PLC starts, does nothing else *)
(* 3. each automaton moves with at most one uncontrollable event *)
(* 4. each automaton writes the orders enabled in its state; if there are several, it picks one at random *)
(* 5. an order shared by several supervisors changes only if all of them propose it *)
(* 6. each automaton moves with the order that was given (controllable event) *)
(* 7. copies signals to other outputs (Mask) *)
(* The states of each automaton are numbered from 0, its initial state: *)
(* state[0]: supervisor SUP_1 *)
(* state[1]: supervisor SUP_2 *)
(* state[2]: supervisor SUP_3 *)
(* state[3]: supervisor SUP_4 *)
(* state[4]: supervisor SUP_5 *)
PROGRAM supcon
	VAR
		(* Internal variables *)
		random : random_number; (* random number generator *)
		random_num : DINT; (* random number of this scan *)
		startup_delay : TON; (* startup delay: no event or order during the first second of the PLC *)
		state : ARRAY [0..5] OF DINT; (* state of each automaton; the list is at the start of the program *)
		slt1 : ARRAY [0..8] OF DINT; (* random choices of supervisor SUP_2, one per state with several orders *)
		slt2 : ARRAY [0..15] OF DINT; (* random choices of supervisor SUP_3, one per state with several orders *)
		GD_OUT_4_G : ARRAY [0..2] OF BOOL; (* proposals of GD_OUT_4 from [0] supervisor SUP_1, [1] supervisor SUP_2 *)
		GD_OUT_7_G : ARRAY [0..2] OF BOOL; (* proposals of GD_OUT_7 from [0] supervisor SUP_2, [1] supervisor SUP_3 *)
		GD_OUT_8_G : ARRAY [0..2] OF BOOL; (* proposals of GD_OUT_8 from [0] supervisor SUP_2, [1] supervisor SUP_3 *)
		GD_OUT_5_G : ARRAY [0..3] OF BOOL; (* proposals of GD_OUT_5 from [0] supervisor SUP_3, [1] supervisor SUP_4, [2] supervisor SUP_5 *)
		FE_LaP : F_TRIG; (* falling edge of GD_IN_2: lid-at-place-FE *)
		FE_BaP : F_TRIG; (* falling edge of GD_IN_3: base-at-place-FE *)
		FE_PaL : F_TRIG; (* falling edge of GD_IN_9: part-leaving-FE *)
		FE_Zag : F_TRIG; (* falling edge of GD_IN_6: z-movement-finish *)
		FE_Xag : F_TRIG; (* falling edge of GD_IN_7: x-movement-finish *)
	END_VAR
	VAR
		(* PLC inputs and outputs *)
		GD_OUT_12 AT %QX101.2 : BOOL; (* output; copy of GD_IN_10 (Mask) *)
 		GD_OUT_13 AT %QX101.3 : BOOL; (* output; copy of GD_IN_11 (Mask) *)
 		GD_OUT_2 AT %QX100.2 : BOOL; (* output; 1 for lids-conveyor-on; 0 for lids-conveyor-off *)
		GD_OUT_3 AT %QX100.3 : BOOL; (* output; 1 for bases-conveyor-on; 0 for bases-conveyor-off *)
		GD_OUT_4 AT %QX100.4 : BOOL; (* output; 1 for Lid-clamp-on; 0 for Lid-clamp-off *)
		GD_OUT_5 AT %QX100.5 : BOOL; (* output; 1 for Base-clamp-on; 0 for Base-clamp-off *)
		GD_OUT_6 AT %QX100.6 : BOOL; (* output; 1 for z-axis-on; 0 for z-axis-off *)
		GD_OUT_7 AT %QX100.7 : BOOL; (* output; 1 for grab-on; 0 for grab-off *)
		GD_OUT_8 AT %QX101.0 : BOOL; (* output; 1 for x-axis-on; 0 for x-axis-off *)
		GD_OUT_9 AT %QX101.1 : BOOL; (* output; 1 for blade-on; 0 for blade-off *)
		GD_IN_15 AT %IX100.15 : BOOL; (* input; 1 for start-on *)
		GD_IN_2 AT %IX100.2 : BOOL; (* input; falling edge (FE_LaP): lid-at-place-FE *)
		GD_IN_4 AT %IX100.4 : BOOL; (* input; 1 for lid-clampled *)
		GD_IN_3 AT %IX100.3 : BOOL; (* input; falling edge (FE_BaP): base-at-place-FE *)
		GD_IN_9 AT %IX101.1 : BOOL; (* input; falling edge (FE_PaL): part-leaving-FE *)
		GD_IN_5 AT %IX100.5 : BOOL; (* input; 1 for base-clampled *)
		GD_IN_6 AT %IX100.6 : BOOL; (* input; falling edge (FE_Zag): z-movement-finish *)
		GD_IN_7 AT %IX100.7 : BOOL; (* input; falling edge (FE_Xag): x-movement-finish *)
		GD_IN_8 AT %IX101.0 : BOOL; (* input; 1 for blade-pos-limit-on *)
		GD_IN_10 AT %IX102.5 : BOOL; (* input; 1 for gen-base *)
		GD_IN_11 AT %IX102.6 : BOOL; (* input; 1 for gen-lid *)
	END_VAR
	(* Input edges *)
	FE_LaP(CLK:= GD_IN_2); (* lid-at-place-FE *)
	FE_BaP(CLK:= GD_IN_3); (* base-at-place-FE *)
	FE_PaL(CLK:= GD_IN_9); (* part-leaving-FE *)
	FE_Zag(CLK:= GD_IN_6); (* z-movement-finish *)
	FE_Xag(CLK:= GD_IN_7); (* x-movement-finish *)
	(* Random number of this scan *)
	random(
		IN := True,
		OUT => random_num);
	(* Startup delay: during the first second the edges only follow the inputs, which read 0 until the first poll of the slave devices; no event, order or copy *)
	startup_delay(IN := TRUE, PT := T#1s);
	IF NOT startup_delay.Q THEN
		RETURN;
	END_IF;
	(* ===== Uncontrollable events: each automaton moves with at most one per scan ===== *)
	(* supervisor SUP_1 (state[0]): uncontrollable transitions *)
	IF state[0] = 0 & GD_IN_15 THEN (* start-on *)
  		state[0] := 1;
  	ELSIF state[0] = 2 & FE_LaP.Q THEN (* lid-at-place-FE *)
  		state[0] := 3;
  	ELSIF state[0] = 5 & GD_IN_4 THEN (* lid-clampled *)
  		state[0] := 6;
  	END_IF;

	(* supervisor SUP_2 (state[1]): uncontrollable transitions *)
	IF state[1] = 0 & GD_IN_4 THEN (* lid-clampled *)
  		state[1] := 1;
  	ELSIF state[1] = 2 & GD_IN_4 THEN (* lid-clampled *)
  		state[1] := 3;
  	ELSIF state[1] = 4 & FE_Zag.Q THEN (* z-movement-finish *)
  		state[1] := 6;
  	ELSIF state[1] = 5 & FE_Zag.Q THEN (* z-movement-finish *)
  		state[1] := 7;
  	ELSIF state[1] = 12 & FE_Zag.Q THEN (* z-movement-finish *)
  		state[1] := 14;
  	ELSIF state[1] = 13 & FE_Zag.Q THEN (* z-movement-finish *)
  		state[1] := 15;
  	ELSIF state[1] = 16 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[1] := 18;
  	ELSIF state[1] = 17 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[1] := 19;
  	ELSIF state[1] = 20 & FE_Zag.Q THEN (* z-movement-finish *)
  		state[1] := 22;
  	ELSIF state[1] = 21 & FE_Zag.Q THEN (* z-movement-finish *)
  		state[1] := 23;
  	ELSIF state[1] = 26 & FE_Zag.Q THEN (* z-movement-finish *)
  		state[1] := 28;
  	ELSIF state[1] = 27 & FE_Zag.Q THEN (* z-movement-finish *)
  		state[1] := 29;
  	ELSIF state[1] = 30 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[1] := 0;
  	ELSIF state[1] = 31 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[1] := 2;
  	END_IF;

	(* supervisor SUP_3 (state[2]): uncontrollable transitions *)
	IF state[2] = 2 & GD_IN_5 THEN (* base-clampled *)
  		state[2] := 4;
  	ELSIF state[2] = 3 & GD_IN_5 THEN (* base-clampled *)
  		state[2] := 5;
  	ELSIF state[2] = 6 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 8;
  	ELSIF state[2] = 7 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 9;
  	ELSIF state[2] = 10 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 12;
  	ELSIF state[2] = 11 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 16;
  	ELSIF state[2] = 13 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 20;
  	ELSIF state[2] = 14 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 17;
  	ELSIF state[2] = 15 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 19;
  	ELSIF state[2] = 18 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 25;
  	ELSIF state[2] = 21 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 24;
  	ELSIF state[2] = 22 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 27;
  	ELSIF state[2] = 22 & GD_IN_5 THEN (* base-clampled *)
  		state[2] := 29;
  	ELSIF state[2] = 23 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 30;
  	ELSIF state[2] = 26 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 0;
  	ELSIF state[2] = 27 & GD_IN_5 THEN (* base-clampled *)
  		state[2] := 34;
  	ELSIF state[2] = 28 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 32;
  	ELSIF state[2] = 28 & GD_IN_5 THEN (* base-clampled *)
  		state[2] := 35;
  	ELSIF state[2] = 29 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 34;
  	ELSIF state[2] = 31 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 1;
  	ELSIF state[2] = 32 & GD_IN_5 THEN (* base-clampled *)
  		state[2] := 37;
  	ELSIF state[2] = 33 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 2;
  	ELSIF state[2] = 33 & GD_IN_5 THEN (* base-clampled *)
  		state[2] := 38;
  	ELSIF state[2] = 35 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 37;
  	ELSIF state[2] = 36 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 3;
  	ELSIF state[2] = 36 & GD_IN_5 THEN (* base-clampled *)
  		state[2] := 39;
  	ELSIF state[2] = 38 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 4;
  	ELSIF state[2] = 39 & FE_Xag.Q THEN (* x-movement-finish *)
  		state[2] := 5;
  	END_IF;

	(* supervisor SUP_4 (state[3]): uncontrollable transitions *)
	IF state[3] = 0 & GD_IN_15 THEN (* start-on *)
  		state[3] := 1;
  	ELSIF state[3] = 2 & FE_BaP.Q THEN (* base-at-place-FE *)
  		state[3] := 3;
  	ELSIF state[3] = 5 & GD_IN_5 THEN (* base-clampled *)
  		state[3] := 6;
  	END_IF;

	(* supervisor SUP_5 (state[4]): uncontrollable transitions *)
	IF state[4] = 3 & GD_IN_8 THEN (* blade-pos-limit-on *)
  		state[4] := 4;
  	ELSIF state[4] = 4 & FE_PaL.Q THEN (* part-leaving-FE *)
  		state[4] := 5;
  	END_IF;

	(* ===== Orders: each automaton writes the orders enabled in its state; if there are several, it picks one at random ===== *)

	(* supervisor SUP_1 (state[0]): orders of each state *)
	CASE state[0] OF
  		1:
  			GD_OUT_2 := 1; (* lids-conveyor-on *)
		3:
  			GD_OUT_2 := 0; (* lids-conveyor-off *)
  		4:
  			GD_OUT_4_G[0] := 1; (* Lid-clamp-on *)
		6:
  			GD_OUT_4_G[0] := 0; (* Lid-clamp-off *)
  	END_CASE;

	(* supervisor SUP_2 (state[1]): orders of each state *)
	CASE state[1] OF
  		0:
  			GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
		1:
  			CASE slt1[0] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
  				1:
  					GD_OUT_6 := 1; (* z-axis-on *)
  			END_CASE;
  			slt1[0] := (random_num + slt1[0]) MOD 2;
  			random_num := random_num - slt1[0];
 		3:
  			GD_OUT_6 := 1; (* z-axis-on *)
		4:
  			GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
		6:
  			CASE slt1[1] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
  				1:
  					GD_OUT_7_G[0] := 1; (* grab-on *)
  			END_CASE;
  			slt1[1] := (random_num + slt1[1]) MOD 2;
  			random_num := random_num - slt1[1];
 		7:
  			GD_OUT_7_G[0] := 1; (* grab-on *)
		8:
  			GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
		9:
  			GD_OUT_4_G[1] := 0; (* Lid-clamp-off *)
  		10:
  			CASE slt1[2] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
  				1:
  					GD_OUT_6 := 0; (* z-axis-off *)
  			END_CASE;
  			slt1[2] := (random_num + slt1[2]) MOD 2;
  			random_num := random_num - slt1[2];
 		11:
  			GD_OUT_6 := 0; (* z-axis-off *)
  		12:
  			GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
		14:
  			CASE slt1[3] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
  				1:
  					GD_OUT_8_G[0] := 1; (* x-axis-on *)
  			END_CASE;
  			slt1[3] := (random_num + slt1[3]) MOD 2;
  			random_num := random_num - slt1[3];
 		15:
  			GD_OUT_8_G[0] := 1; (* x-axis-on *)
		16:
  			GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
		18:
  			CASE slt1[4] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
  				1:
  					GD_OUT_6 := 1; (* z-axis-on *)
  			END_CASE;
  			slt1[4] := (random_num + slt1[4]) MOD 2;
  			random_num := random_num - slt1[4];
 		19:
  			GD_OUT_6 := 1; (* z-axis-on *)
		20:
  			GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
		22:
  			CASE slt1[5] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
  				1:
  					GD_OUT_7_G[0] := 0; (* grab-off *)
  			END_CASE;
  			slt1[5] := (random_num + slt1[5]) MOD 2;
  			random_num := random_num - slt1[5];
 		23:
  			GD_OUT_7_G[0] := 0; (* grab-off *)
  		24:
  			CASE slt1[6] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
  				1:
  					GD_OUT_6 := 0; (* z-axis-off *)
  			END_CASE;
  			slt1[6] := (random_num + slt1[6]) MOD 2;
  			random_num := random_num - slt1[6];
 		25:
  			GD_OUT_6 := 0; (* z-axis-off *)
  		26:
  			GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
		28:
  			CASE slt1[7] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
  				1:
  					GD_OUT_8_G[0] := 0; (* x-axis-off *)
  			END_CASE;
  			slt1[7] := (random_num + slt1[7]) MOD 2;
  			random_num := random_num - slt1[7];
 		29:
  			GD_OUT_8_G[0] := 0; (* x-axis-off *)
  		30:
  			GD_OUT_4_G[1] := 1; (* Lid-clamp-on *)
	END_CASE;

	(* supervisor SUP_3 (state[2]): orders of each state *)
	CASE state[2] OF
  		0:
  			CASE slt2[0] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_7_G[1] := 1; (* grab-on *)
  				1:
  					GD_OUT_5_G[0] := 1; (* Base-clamp-on *)
  			END_CASE;
  			slt2[0] := (random_num + slt2[0]) MOD 2;
  			random_num := random_num - slt2[0];
 		1:
  			GD_OUT_5_G[0] := 1; (* Base-clamp-on *)
		2:
  			GD_OUT_7_G[1] := 1; (* grab-on *)
		4:
  			CASE slt2[1] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_7_G[1] := 1; (* grab-on *)
  				1:
  					GD_OUT_8_G[1] := 1; (* x-axis-on *)
  			END_CASE;
  			slt2[1] := (random_num + slt2[1]) MOD 2;
  			random_num := random_num - slt2[1];
 		5:
  			GD_OUT_8_G[1] := 1; (* x-axis-on *)
		6:
  			GD_OUT_7_G[1] := 1; (* grab-on *)
		7:
  			GD_OUT_7_G[1] := 0; (* grab-off *)
  		8:
  			CASE slt2[2] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_7_G[1] := 1; (* grab-on *)
  				1:
  					GD_OUT_8_G[1] := 0; (* x-axis-off *)
  			END_CASE;
  			slt2[2] := (random_num + slt2[2]) MOD 2;
  			random_num := random_num - slt2[2];
 		9:
  			CASE slt2[3] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_7_G[1] := 0; (* grab-off *)
  				1:
  					GD_OUT_8_G[1] := 0; (* x-axis-off *)
  			END_CASE;
  			slt2[3] := (random_num + slt2[3]) MOD 2;
  			random_num := random_num - slt2[3];
 		10:
  			CASE slt2[4] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_7_G[1] := 1; (* grab-on *)
  				1:
  					GD_OUT_5_G[0] := 0; (* Base-clamp-off *)
  			END_CASE;
  			slt2[4] := (random_num + slt2[4]) MOD 2;
  			random_num := random_num - slt2[4];
 		11:
  			GD_OUT_7_G[1] := 1; (* grab-on *)
		12:
  			CASE slt2[5] OF (* one of 3 orders, at random *)
  				0:
  					GD_OUT_7_G[1] := 1; (* grab-on *)
  				1:
  					GD_OUT_8_G[1] := 0; (* x-axis-off *)
  				2:
  					GD_OUT_5_G[0] := 0; (* Base-clamp-off *)
  			END_CASE;
  			slt2[5] := (random_num + slt2[5]) MOD 3;
  			random_num := random_num - slt2[5];
 		13:
  			GD_OUT_7_G[1] := 0; (* grab-off *)
  		14:
  			GD_OUT_5_G[0] := 0; (* Base-clamp-off *)
  		15:
  			CASE slt2[6] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_7_G[1] := 1; (* grab-on *)
  				1:
  					GD_OUT_5_G[0] := 1; (* Base-clamp-on *)
  			END_CASE;
  			slt2[6] := (random_num + slt2[6]) MOD 2;
  			random_num := random_num - slt2[6];
 		16:
  			GD_OUT_7_G[1] := 1; (* grab-on *)
		17:
  			CASE slt2[7] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_8_G[1] := 0; (* x-axis-off *)
  				1:
  					GD_OUT_5_G[0] := 0; (* Base-clamp-off *)
  			END_CASE;
  			slt2[7] := (random_num + slt2[7]) MOD 2;
  			random_num := random_num - slt2[7];
 		18:
  			CASE slt2[8] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_7_G[1] := 1; (* grab-on *)
  				1:
  					GD_OUT_5_G[0] := 0; (* Base-clamp-off *)
  			END_CASE;
  			slt2[8] := (random_num + slt2[8]) MOD 2;
  			random_num := random_num - slt2[8];
 		19:
  			CASE slt2[9] OF (* one of 3 orders, at random *)
  				0:
  					GD_OUT_7_G[1] := 1; (* grab-on *)
  				1:
  					GD_OUT_8_G[1] := 0; (* x-axis-off *)
  				2:
  					GD_OUT_5_G[0] := 1; (* Base-clamp-on *)
  			END_CASE;
  			slt2[9] := (random_num + slt2[9]) MOD 3;
  			random_num := random_num - slt2[9];
 		20:
  			GD_OUT_7_G[1] := 0; (* grab-off *)
  		21:
  			GD_OUT_5_G[0] := 1; (* Base-clamp-on *)
		22:
  			GD_OUT_7_G[1] := 1; (* grab-on *)
		23:
  			GD_OUT_5_G[0] := 0; (* Base-clamp-off *)
  		24:
  			CASE slt2[10] OF (* one of 2 orders, at random *)
  				0:
  					GD_OUT_8_G[1] := 0; (* x-axis-off *)
  				1:
  					GD_OUT_5_G[0] := 1; (* Base-clamp-on *)
  			END_CASE;
  			slt2[10] := (random_num + slt2[10]) MOD 2;
  			random_num := random_num - slt2[10];
 		25:
  			CASE slt2[11] OF (* one of 2 orders, at random *)
  				0:
